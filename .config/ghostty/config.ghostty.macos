# macOS-specific overrides
# NOTE: zsh lives at /bin/zsh on macOS, not /usr/bin/zsh, so `command` is
# left unset here and Ghostty falls back to the $SHELL lookup.
font-size = 10
background-blur = true
# Fallback: keeps CJK readable if the fusion font is missing (see font-family in config.ghostty)
font-family = PingFang SC
